# Keep the Docker build context lean. NOTE: console/ and e2e/fakerest.py are
# runtime dependencies of `yantraops up --loopback` — never ignore those.
.git
.github
.gitignore
.venv
.venv-*
**/__pycache__
**/*.pyc
**/*.egg-info
.pytest_cache
**/.pytest_cache
docker/README.md
TEST-REPORT.md
supabase
scripts
**/eval
**/tests
e2e/test_e2e.py

# Never bake local secrets or editor/agent state into an image layer.
.env
.env.*
*.pem
*.key
.claude
.idea
.vscode
.DS_Store
*.patch
